# Data and model artefacts — never commit these.
# Leading slashes are load-bearing: an unanchored `data/` matches a directory
# named `data` at ANY depth, and silently excluded the src/pathgrade/data/
# source package for the entire life of the repo. Anchor anything whose name
# could collide with a package directory.
/data/
/runs/
*.h5
*.svs
*.ndpi
*.tiff
*.pt
*.pth
*.ckpt
*.npz

# Extraction outputs
extraction_manifest.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
/.venv/
/venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.env
